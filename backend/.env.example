# DocSync Backend — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Gemma 4 API ──────────────────────────────────────────────────────────────
# Required to enable AI-powered semantic analysis.
#
# GEMMA_API_URL: Full URL to your Gemma endpoint.
#   Examples:
#     Google AI Studio: https://generativelanguage.googleapis.com/v1beta/models/gemma-3-27b-it:generateContent
#     Vertex AI:        https://REGION-aiplatform.googleapis.com/v1/projects/PROJECT/locations/REGION/publishers/google/models/gemma:generateContent
#     OpenAI-compatible: https://your-host/v1/chat/completions
#
GEMMA_API_URL=

# GEMMA_API_KEY: Your API key.
#   For Google AI Studio: your Google AI Studio API key
#   For Vertex AI: use a Bearer token or service account key
#
GEMMA_API_KEY=

# GEMMA_MODEL: Model identifier (optional, endpoint-dependent).
#   Examples: gemma-3-27b-it, gemma-2-9b-it, gemma2-27b
#
GEMMA_MODEL=

# ── GitHub (optional) ─────────────────────────────────────────────────────────
# Adding a GitHub token raises the API rate limit from 60 to 5000 req/hour.
# Not required for public repositories.
#
GITHUB_TOKEN=

# ── Analysis limits (optional) ───────────────────────────────────────────────
# MAX_FILES=60
# MAX_FILE_SIZE_BYTES=200000
# MAX_TOTAL_BYTES=3000000
# REQUEST_TIMEOUT=30
