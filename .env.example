# DocSync — Environment Configuration
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit .env to version control.

# ── Gemma 4 API ──────────────────────────────────────────────────────────────
# Required to enable AI-powered semantic analysis.
#
# GEMMA_API_URL: Full URL to your Gemma 4 endpoint.
#   Examples:
#     Google AI Studio: https://generativelanguage.googleapis.com/v1beta/models/gemma-4-it:generateContent
#     OpenAI-compatible: https://your-host/v1/chat/completions
#
GEMMA_API_URL=

# GEMMA_API_KEY: Your API key.
GEMMA_API_KEY=

# GEMMA_MODEL: Model identifier (optional, if endpoint requires it).
GEMMA_MODEL=

# ── GitHub (optional) ─────────────────────────────────────────────────────────
# Raises rate limits from 60 to 5000 req/hour for scanning public repositories.
GITHUB_TOKEN=
